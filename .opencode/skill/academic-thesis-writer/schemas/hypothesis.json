{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-thesis-writer/schemas/hypothesis.json",
  "title": "Hypothesis",
  "type": "object",
  "required": ["id", "text", "direction", "rq_id", "test_method", "status", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^HYP-\\d{3}$" },
    "text": { "type": "string", "minLength": 1 },
    "direction": { "type": "string", "enum": ["positive", "negative", "non-directional"] },
    "rq_id": { "type": "string", "pattern": "^RQ-\\d{3}$" },
    "test_method": { "type": "string" },
    "status": { "type": "string", "enum": ["proposed", "tested", "supported", "rejected", "inconclusive"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
