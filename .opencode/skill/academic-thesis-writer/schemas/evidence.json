{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-thesis-writer/schemas/evidence.json",
  "title": "Evidence Snippet",
  "type": "object",
  "required": [
    "id", "source_id", "claim_id", "quote", "location", "supports",
    "certainty", "extracted_by", "created_at", "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^EVD-\\d{4}-\\d{3}$" },
    "source_id": { "type": "string", "pattern": "^SRC-\\d{4}-\\d{3}$" },
    "claim_id": { "type": "string", "pattern": "^CLM-\\d{4}-\\d{3}$" },
    "quote": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "location": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "type": "string", "enum": ["page", "section", "paragraph", "figure", "table", "equation", "timestamp"] },
        "value": { "type": "string" },
        "context": { "type": "string" }
      },
      "additionalProperties": false
    },
    "supports": { "type": "boolean" },
    "certainty": { "type": "string", "enum": ["low", "medium", "high"] },
    "extracted_by": { "type": "string", "enum": ["evidence-extractor", "manual", "pdf_extract", "auto_verify"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}