{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-thesis-writer/schemas/citation.json",
  "title": "Citation",
  "type": "object",
  "required": [
    "id", "source_id", "location", "page", "quote", "context",
    "supports_claim_id", "style", "created_at", "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^CIT-\\d{4}-\\d{3}$" },
    "source_id": { "type": "string", "pattern": "^SRC-\\d{4}-\\d{3}$" },
    "location": { "type": "string", "minLength": 1 },
    "page": { "type": "string" },
    "quote": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "context": { "type": "string", "minLength": 1 },
    "supports_claim_id": { "type": "string", "pattern": "^CLM-\\d{4}-\\d{3}$" },
    "style": { "type": "string", "enum": ["apa7", "ieee", "harvard", "chicago", "mla"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
