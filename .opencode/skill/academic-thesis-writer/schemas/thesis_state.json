{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-thesis-writer/schemas/thesis_state.json",
  "title": "Thesis State",
  "type": "object",
  "required": [
    "thesis_id", "title", "language", "style_profile", "schema_version",
    "version", "created_at", "updated_at", "methodology", "human_approvals",
    "definitions", "conceptual_framework", "open_questions", "quality_issues",
    "research_questions", "hypotheses", "chapters", "variables",
    "evidence_registry", "claims_registry", "findings_registry",
    "discussion_registry", "conclusion_registry", "gap_registry",
    "audit_registry", "search_runs", "sources", "citations",
    "datasets", "analyses", "statistics", "tables", "figures"
  ],
  "properties": {
    "thesis_id": { "type": "string", "pattern": "^THESIS-\\d{4}-\\d{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "enum": ["tr", "en"] },
    "style_profile": { "type": "string", "enum": ["apa7", "ieee", "harvard", "chicago", "mla"] },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "methodology": { "type": "object" },
    "human_approvals": { "type": "object" },
    "definitions": { "type": "array", "items": { "type": "object" } },
    "conceptual_framework": { "type": "array", "items": { "type": "object" } },
    "open_questions": { "type": "array", "items": { "type": "object" } },
    "quality_issues": { "type": "array", "items": { "type": "object" } },
    "research_questions": { "type": "array", "items": { "$ref": "research_question.json" } },
    "hypotheses": { "type": "array", "items": { "$ref": "hypothesis.json" } },
    "chapters": { "type": "array", "items": { "$ref": "chapter.json" } },
    "variables": { "type": "array", "items": { "$ref": "variable.json" } },
    "evidence_registry": { "type": "array", "items": { "$ref": "evidence.json" } },
    "claims_registry": { "type": "array", "items": { "$ref": "claim.json" } },
    "findings_registry": { "type": "array", "items": { "$ref": "finding.json" } },
    "discussion_registry": { "type": "array", "items": { "$ref": "discussion.json" } },
    "conclusion_registry": { "type": "array", "items": { "$ref": "conclusion.json" } },
    "gap_registry": { "type": "array", "items": { "$ref": "research_gap.json" } },
    "audit_registry": { "type": "array", "items": { "$ref": "audit.json" } },
    "search_runs": { "type": "array", "items": { "$ref": "search_run.json" } },
    "sources": { "type": "array", "items": { "$ref": "source.json" } },
    "citations": { "type": "array", "items": { "$ref": "citation.json" } },
    "datasets": { "type": "array", "items": { "$ref": "dataset.json" } },
    "analyses": { "type": "array", "items": { "$ref": "analysis.json" } },
    "statistics": { "type": "array", "items": { "$ref": "statistic.json" } },
    "tables": { "type": "array", "items": { "$ref": "table.json" } },
    "figures": { "type": "array", "items": { "$ref": "figure.json" } }
  },
  "additionalProperties": false
}