{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-thesis-writer/schemas/conclusion.json",
  "title": "Conclusion Section",
  "type": "object",
  "required": [
    "id", "rq_ids", "finding_ids", "answers", "contributions",
    "future_work", "limitations_acknowledged", "status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^CON-\\d{4}-\\d{3}$" },
    "rq_ids": { "type": "array", "items": { "type": "string", "pattern": "^RQ-\\d{3}$" }, "minItems": 1 },
    "finding_ids": { "type": "array", "items": { "type": "string", "pattern": "^FND-\\d{4}-\\d{3}$" }, "minItems": 1 },
    "answers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "contributions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "future_work": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "limitations_acknowledged": { "type": "boolean" },
    "status": { "type": "string", "enum": ["draft", "reviewed", "approved", "final"] }
  },
  "additionalProperties": false
}
