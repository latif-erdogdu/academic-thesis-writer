{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-thesis-writer/schemas/research_question.json",
  "title": "Research Question",
  "type": "object",
  "required": ["id", "text", "type", "linked_hypothesis_ids", "status", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^RQ-\\d{3}$" },
    "text": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["descriptive", "explanatory", "predictive", "exploratory", "comparative"] },
    "linked_hypothesis_ids": { "type": "array", "items": { "type": "string", "pattern": "^HYP-\\d{3}$" }, "minItems": 0 },
    "status": { "type": "string", "enum": ["active", "answered", "refined", "deferred", "abandoned"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}