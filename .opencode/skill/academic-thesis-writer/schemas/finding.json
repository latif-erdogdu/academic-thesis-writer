{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-thesis-writer/schemas/finding.json",
  "title": "Research Finding",
  "type": "object",
  "required": [
    "id", "text", "hypothesis_id", "evidence_ids", "direction",
    "effect_size", "statistical_significance", "confidence", "status",
    "created_at", "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^FND-\\d{4}-\\d{3}$" },
    "text": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string", "pattern": "^HYP-\\d{3}$" },
    "evidence_ids": { "type": "array", "items": { "type": "string", "pattern": "^EVD-\\d{4}-\\d{3}$" }, "minItems": 1 },
    "direction": { "type": "string", "enum": ["supported", "rejected", "inconclusive", "mixed"] },
    "effect_size": { "type": ["number", "null"] },
    "statistical_significance": { "type": ["string", "null"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "status": { "type": "string", "enum": ["tentative", "established", "refuted", "replicated"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
