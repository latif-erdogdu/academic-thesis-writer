{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-thesis-writer/schemas/variable.json",
  "title": "Variable",
  "type": "object",
  "required": ["id", "name", "type", "operational_definition", "measurement", "unit", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^VAR-\\d{3}$" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["independent", "dependent", "control", "moderator", "mediator", "confounding"] },
    "operational_definition": { "type": "string", "minLength": 1 },
    "measurement": { "type": "string", "minLength": 1 },
    "unit": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
