{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-thesis-writer/schemas/claim.json",
  "title": "Academic Claim",
  "type": "object",
  "required": [
    "id", "text", "type", "certainty", "rq_id", "hypothesis_id",
    "evidence_ids", "source_ids", "status", "created_at", "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^CLM-\\d{4}-\\d{3}$" },
    "text": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["empirical", "theoretical", "methodological", "definitional", "axiomatic"] },
    "certainty": { "type": "string", "enum": ["low", "medium", "high", "speculative"] },
    "rq_id": { "type": "string", "pattern": "^RQ-\\d{3}$" },
    "hypothesis_id": { "type": "string", "pattern": "^HYP-\\d{3}$" },
    "evidence_ids": { "type": "array", "items": { "type": "string", "pattern": "^EVD-\\d{4}-\\d{3}$" }, "minItems": 0 },
    "source_ids": { "type": "array", "items": { "type": "string", "pattern": "^SRC-\\d{4}-\\d{3}$" }, "minItems": 1 },
    "status": { "type": "string", "enum": ["supported", "contradicted", "partial", "unverified", "retracted"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}