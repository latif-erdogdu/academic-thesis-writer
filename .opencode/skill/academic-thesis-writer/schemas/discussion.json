{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-thesis-writer/schemas/discussion.json",
  "title": "Discussion Section",
  "type": "object",
  "required": [
    "id", "finding_ids", "interpretation", "limitations", "implications",
    "relation_to_prior_work", "alternative_explanations", "status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^DSC-\\d{4}-\\d{3}$" },
    "finding_ids": { "type": "array", "items": { "type": "string", "pattern": "^FND-\\d{4}-\\d{3}$" }, "minItems": 1 },
    "interpretation": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "implications": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "relation_to_prior_work": { "type": "string", "minLength": 1 },
    "alternative_explanations": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "status": { "type": "string", "enum": ["draft", "reviewed", "approved", "final"] }
  },
  "additionalProperties": false
}
