{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/latif-erdogdu/academic-thesis-writer/schemas/finding.json",
  "title": "Bulgu",
  "description": "Tezin bir bulgu olarak kabul edilmesi icin yeterli dugumlari barinan bulgu kaydi.",
  "type": "object",
  "required": [
    "id",
    "text",
    "evidence_type",
    "strength"
  ],
  "examples": [
    {
      "$comment": "KURGUSAL ORNEK. Gercek bir bulgu temsil etmez. Yalnizca sema dogrulamasi icin kullanilir.",
      "id": "FND-001",
      "text": "Kurgusal bir bulgu metni.",
      "evidence_type": "literature",
      "title": "Ornek Bulgu",
      "supports_claim": "CLM-001",
      "strength": "direct",
      "source_id": "SRC-001",
      "location": {
        "page": 1,
        "section": "3.2",
        "paragraph": null
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FND-\\d{3,}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "enum": [
        "literature",
        "primary_data",
        "statistical",
        "theory",
        "method"
      ]
    },
    "supports_claim": {
      "type": "string",
      "pattern": "^CLM-\\d{3,}$"
    },
    "strength": {
      "enum": [
        "direct",
        "indirect"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^SRC-\\d{3,}$"
    },
    "location": {
      "type": "object",
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "section": {
          "type": "string"
        },
        "paragraph": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
