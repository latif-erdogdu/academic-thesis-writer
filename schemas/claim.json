{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/latif-erdogdu/academic-thesis-writer/schemas/claim.json",
  "title": "Taleb",
  "description": "Tezin bir iddia olarak kabul edilmesi icin yeterli dugumlari barinan iddia kaydi.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "contradicted_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "strength": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "text",
    "evidence_ids"
  ],
  "examples": [
    {
      "$comment": "KURGUSAL ORNEK. Gercek bir iddia temsil etmez. Yalnizca sema dogrulamasi icin kullanilir.",
      "id": "CLM-001",
      "text": "Kurgusal bir iddia metni.",
      "evidence_ids": [
        "EVD-001"
      ],
      "contradicted_by": null,
      "gap_ids": [],
      "strength": "direct",
      "verified": true
    }
  ]
}
